# Coralogix → Data Flow → API Keys → Send-Your-Data
CORALOGIX_SEND_YOUR_DATA_KEY=your-coralogix-send-your-data-key

# Domain examples: eu1.coralogix.com, eu2.coralogix.com, coralogix.in, cx498.coralogix.com
CORALOGIX_DOMAIN=eu1.coralogix.com
CORALOGIX_APPLICATION_NAME=s3-zst
CORALOGIX_SUBSYSTEM_NAME=logs

# Optional: read the API key from Secrets Manager instead of the env var above
# CORALOGIX_API_KEY_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name

CORALOGIX_BATCH_SIZE=200
CORALOGIX_MAX_BATCH_BYTES=1500000
HTTP_TIMEOUT_SECONDS=60

# Shell-style include/exclude patterns for S3 keys (comma-separated).
# Exclude wins. Include default is *.zst,*.zstd. Use * to include every key.
S3_KEY_INCLUDE_PATTERNS=*.zst,*.zstd
S3_KEY_EXCLUDE_PATTERNS=

LOG_LEVEL=INFO
# DRY_RUN=true
